# =========================================================
# SatQuery AI — Environment Variables
# =========================================================

# --- Frontend (Vite & Tauri Webview) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_WS_BASE_URL=ws://127.0.0.1:8000/ws/chat

# --- Backend (FastAPI & ATS) ---
ENVIRONMENT=development
CLERK_SECRET_KEY=sk_test_your_secret_key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/satquery

# AI & EO Execution
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=openai/gpt-oss-120b
LLM_ENABLED=true
EO_EXECUTION_MODE=live
# MODEL_MODE is deprecated; use EO_EXECUTION_MODE (live | worker | mock)
ALLOW_MOCK_FALLBACK=false

# Remote Worker URLs (when EO_EXECUTION_MODE=worker)
PRITHVI_WORKER_URL=
GEOCHAT_WORKER_URL=
TERRAFM_WORKER_URL=
CLOSP_WORKER_URL=

IMAGE_OUTPUT_DIR=app/static/generated
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
