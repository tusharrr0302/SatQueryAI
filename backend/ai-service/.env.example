# ─────────────────────────────────────────────────────────────────────────────
# SatQuery AI — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains your secret API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Orchestrator (GPT-OSS) ───────────────────────────────────────────────
# The LLM that acts as the autonomous orchestrator / tool router.
#
# Supported providers (all use OpenAI-compatible API format):
#   openai    → https://api.openai.com/v1
#   groq      → https://api.groq.com/openai/v1
#   together  → https://api.together.xyz/v1
#   vllm      → http://localhost:8001/v1  (local vLLM server)
#   ollama    → http://localhost:11434/v1 (local Ollama server)
#
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key-here

# The exact model name as the provider expects it.
# Groq models that support tool calling:
#   openai/gpt-oss-120b                    (recommended per SIH spec)
#   moonshotai/kimi-k2-instruct            (large, excellent tool use)
#   llama-3.3-70b-versatile                (fast, reliable tool calling)
#
LLM_MODEL=openai/gpt-oss-120b

# Max tokens for the LLM response (increase for longer analyses)
LLM_MAX_TOKENS=2048

# ── Specialist Models ─────────────────────────────────────────────────────────
# Controls whether specialist tools run real inference via Kaggle workers
# or return clearly-labelled mock results.
#
#   mock  → Safe for development, no GPU/Kaggle required, results are fake
#   real  → Routes requests to Kaggle GPU workers via ngrok (set URLs below)
#
MODEL_MODE=mock

# ── Remote Kaggle GPU Worker URLs ─────────────────────────────────────────────
# Each specialist capability runs on its OWN independent Kaggle notebook.
# Set these when MODEL_MODE=real.
#
# Worker 1: EarthDial-4B-MS notebook → /analyze  (replaces GeoChat)
EARTHDIAL_WORKER_URL=https://your-earthdial-ngrok-url.ngrok-free.app

# Worker 1 (legacy): GeoChat-7B notebook → /tools/analyze_image  (kept for backward compatibility)
# GEOCHAT_WORKER_URL=https://your-geochat-ngrok-url.ngrok-free.app

# Worker 2: VisTA + Prithvi-EO-2.0-300M notebook → /tools/detect_change
CHANGE_DETECTION_WORKER_URL=https://your-change-detection-ngrok-url.ngrok-free.app

# VisTA Worker notebook → /tools/detect_change
VISTA_WORKER_URL=https://your-vista-ngrok-url.ngrok-free.app

# Prithvi Worker notebook → /tools/analyze_multitemporal
PRITHVI_WORKER_URL=https://your-prithvi-ngrok-url.ngrok-free.app

# Worker 3a: CLOSP notebook → /analyze  (SAR+optical embedding/similarity specialist)
CLOSP_WORKER_URL=https://your-closp-ngrok-url.ngrok-free.app

# Worker 3b: TerraFM notebook → /analyze  (SAR+optical multisensor foundation model)
TERRAFM_WORKER_URL=https://your-terrafm-ngrok-url.ngrok-free.app

# Worker 3 (legacy): combined SAR+optical notebook  (kept for backward compatibility)
# SAR_OPTICAL_WORKER_URL=https://your-sar-optical-ngrok-url.ngrok-free.app

# Timeout in seconds for remote worker HTTP calls (GPU inference can be slow)
WORKER_TIMEOUT_SECONDS=120

# ── Copernicus Data Space Ecosystem ───────────────────────────────────────────
# For Sentinel-1 (SAR) and Sentinel-2 (optical multispectral) data.
#
# OData API: https://catalogue.dataspace.copernicus.eu/odata/v1
# Token URL: https://identity.dataspace.copernicus.eu/auth/realms/CDSE/
#            protocol/openid-connect/token
#
# Register (free): https://dataspace.copernicus.eu/
# Required only when MODEL_MODE=real and satellite tools are called.
#
COPERNICUS_USER=your-copernicus-email@example.com
COPERNICUS_PASSWORD=your-copernicus-password

# ── USGS M2M API ──────────────────────────────────────────────────────────────
# For Landsat 8 / Landsat 9 data.
#
# API endpoint: https://m2m.cr.usgs.gov/api/api/json/stable/
# API docs:     https://m2m.cr.usgs.gov/api/docs/json/
#
# Register (free): https://ers.cr.usgs.gov/register
# After registering, create an Application Token in your profile.
# Required only when MODEL_MODE=real and fetch_landsat tool is called.
#
USGS_USERNAME=your-usgs-username
USGS_TOKEN=your-usgs-application-token

# ── NASA CMR API ──────────────────────────────────────────────────────────────
# For VIIRS and MODIS data.
# Public API — no authentication required for most collections.
# Default endpoint is correct, override only if needed.
#
NASA_CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search

# ── FastAPI Service ───────────────────────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
